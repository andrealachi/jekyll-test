      <Option type="QString" value="" name="color"/>
      <Option type="Map" name="comment">
        <Option type="QString" value="" name="color"/>
        <Option type="QString" value="Save log to file is a Model Designer–only utility tool that exports the execution log of the current model run to a file on disk. &#xa;It lets you choose whether to save the log as plain text log, and the output file path can be set dynamically (e.g., using a model parameter such as a user-selected folder). [creagov-my...epoint.com]&#xa;In practice, it’s used to persist the full run trace (inputs, executed steps, messages, warnings/errors shown in the Processing log) so you can archive it, share it, or inspect it later" name="component_description"/>
        <Option type="double" value="150" name="component_height"/>
        <Option type="double" value="3825" name="component_pos_x"/>
        <Option type="double" value="2115" name="component_pos_y"/>
        <Option type="double" value="210" name="component_width"/>
        <Option type="bool" value="true" name="outputs_collapsed"/>
        <Option type="bool" value="true" name="parameters_collapsed"/>
      </Option>
