    <Option type="QString" value="C:\Users\andrea.lachi\OneDrive - CREA\Documenti\Geopackage_SoilWise\materiale_lavoro\dati_test_copy\SoilWise_Void_05.gpkg" name="target_gpkg"/>
  </Option>
  <Option name="groupBoxes"/>
  <Option type="Map" name="help">
    <Option type="QString" value="andrea.lachi@crea.gov.it" name="ALG_CREATOR"/>
    <Option type="QString" value="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:8pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>This tool compares each table in the &lt;span style=&quot; font-weight:600;&quot;>SOURCE GeoPackage &lt;/span>with the corresponding table in the &lt;span style=&quot; font-weight:600;&quot;>TARGET GeoPackage&lt;/span>. &lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>For each table analysed, the model identifies records that are present in the source GeoPackage but missing from the corresponding table in the target GeoPackage. The missing records are then &lt;span style=&quot; font-weight:600;&quot;>appended to the TARGET GeoPackage&lt;/span>. &lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>The comparison is mainly performed using the guid identifier field: if a record with the same guid already exists in the TARGET, it is not copied again. This prevents duplicate records from being created if the tool is run multiple times on the same datasets. The model uses SQL queries of the following type to identify missing records: &lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>SELECT ... WHERE NOT EXISTS (...) &lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>The selected records are then copied to the TARGET using GDAL append operations. &lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>The model is organised into functional blocks. Some tables are always checked and copied when needed, while others are processed only when the corresponding Boolean parameters are enabled. The main execution conditions are managed through Conditional Branch tools in the QGIS Model Designer. &lt;/p>&lt;/body>&lt;/html>" name="ALG_DESC"/>
    <Option type="QString" value="andrea.lachi@crea.gov.it" name="ALG_HELP_CREATOR"/>
    <Option type="QString" value="1.0" name="ALG_VERSION"/>
    <Option type="invalid" name="EXAMPLES"/>
    <Option type="invalid" name="HELP_URL"/>
    <Option type="invalid" name="SHORT_DESCRIPTION"/>
    <Option type="QString" value="When enabled, this parameter copies derived Soil Profiles, i.e. profiles where: &#xa;isderived = 1 &#xa;The model copies the derived profiles, their related profileelement records, associated descriptive tables, related datastream records, and corresponding observation records. &#xa;isderivedfrom Relationship&#xa;&#xa;The isderivedfrom table is copied only when both of the following parameters are enabled: &#xa;Copy Derived Soil Profile = TRUE &#xa;Copy Observed Soil Profile = TRUE &#xa;This table represents the relationship between derived and observed profiles. Copying it when only one of the two profile groups is included could create references to profiles that are not present in the TARGET GeoPackage. " name="copy_derived_soil_profile"/>
    <Option type="QString" value="When enabled, this parameter copies observed Soil Profiles, i.e. profiles where: &#xa;isderived = 0 &#xa;The model copies the observed profiles, their related profileelement records, associated descriptive tables, related datastream records, and corresponding observation records. " name="copy_observed_soil_profile"/>
    <Option type="QString" value="When enabled, this parameter copies data related to Soil Bodies, including: &#xa;• soilbody records; &#xa;• soilbody_geom records; &#xa;• derivedprofilepresenceinsoilbody records, if derived Soil Profiles are also enabled; &#xa;• isbasedonsoilbody records, if Soil Derived Objects are also enabled. &#xa;When disabled, Soil Body records, their geometries, and directly dependent relationships are not copied. " name="copy_soil_body"/>
    <Option type="QString" value="When enabled, this parameter copies data related to Soil Derived Objects, including: &#xa;•soilderivedobject records; &#xa;•isbasedonsoilderivedobject records; &#xa;•isbasedonobservedsoilprofile records, if observed Soil Profiles are also enabled; &#xa;•isbasedonsoilbody records, if Copy Soil Body is also enabled; &#xa;•datastream records linked to Soil Derived Objects; &#xa;•observation records associated with those datastreams. &#xa;When disabled, Soil Derived Object records and their related observational or relational data are not copied. " name="copy_soil_derived_object"/>
    <Option type="QString" value="When enabled, this parameter copies data related to Soil Sites, including: &#xa;• soilsite records; &#xa;• datastream records linked to Soil Sites; &#xa;• observation records associated with those datastreams. &#xa;When disabled, Soil Site records and their related datastream and observation records are not copied. " name="copy_soil_site"/>
    <Option type="QString" value="Select a folder where the log file will be saved. " name="log_folder"/>
    <Option type="QString" value="Select the GeoPackage containing the source data. &#xa;This file represents the database from which the model reads the records to be checked and, if necessary, copied to the TARGET. " name="source_gpkg"/>
    <Option type="QString" value="Select the GeoPackage where the missing records will be appended. &#xa;The TARGET must have a structure consistent with the SOURCE, meaning that it must contain the same tables expected by the model. " name="target_gpkg"/>
  </Option>
  <Option type="QString" value="Version2" name="internal_version"/>
